---
skip_list:
  - yaml[line-length]
  - name[casing]

warn_list:
  - experimental

enable_list:
  - fqcn
  - no-changed-when
  - no-handler

use_default_rules: true
offline: false

# Included via include_tasks from the playbooks, so they are task files despite
# living in playbooks/ - without this ansible-lint parses them as plays.
kinds:
  - tasks: "playbooks/teardown_eni_cleanup.yml"
  - tasks: "playbooks/topology_check.yml"
