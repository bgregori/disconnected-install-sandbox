---
skip_list:
  - yaml[line-length]
  - name[casing]

warn_list:
  - experimental

enable_list:
  - fqcn
  - no-changed-when
  - no-handler

use_default_rules: true
offline: false

# Included via include_tasks from teardown.yml, so it is a task file despite
# living in playbooks/ - without this ansible-lint parses it as a play.
kinds:
  - tasks: "playbooks/teardown_eni_cleanup.yml"
