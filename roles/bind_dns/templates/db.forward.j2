$TTL 86400
@   IN  SOA  services.{{ bind_dns_zone }}. admin.{{ bind_dns_zone }}. (
    {{ ansible_date_time.epoch | default('2024010101') }} ; serial
    3600       ; refresh
    900        ; retry
    604800     ; expire
    86400      ; minimum TTL
)

@          IN  NS   services.{{ bind_dns_zone }}.

{% for record in bind_dns_records %}
{% if record.name == '*.apps' %}
*.apps     IN  A    {{ record.ip }}
{% else %}
{{ "%-10s" | format(record.name) }} IN  A    {{ record.ip }}
{% endif %}
{% endfor %}
